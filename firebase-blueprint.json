{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with professional identity, contact info, ratings, and portfolio",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["Employee", "Employer", "BusinessOwner"] },
        "occupation": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "skills": { "type": "string", "maxLength": 1000 },
        "resumeContent": { "type": "string", "maxLength": 5000 },
        "photo": { "type": "string", "maxLength": 500000 },
        "logo": { "type": "string", "maxLength": 500000 },
        "bizName": { "type": "string", "maxLength": 100 },
        "business": { "type": "string", "maxLength": 100 },
        "speciality": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 200 },
        "contact": { "type": "string", "maxLength": 100 },
        "views": { "type": "number" },
        "openToWork": { "type": "boolean" },
        "assignedPost": { "type": "string", "maxLength": 100 },
        "assignedBiz": { "type": "string", "maxLength": 100 },
        "isVerified": { "type": "boolean" },
        "verificationPending": { "type": "boolean" },
        "verificationDoc": { "type": "string", "maxLength": 500000 },
        "verificationType": { "type": "string", "maxLength": 50 },
        "verificationReason": { "type": "string", "maxLength": 500 },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["email"]
    },
    "Job": {
      "title": "Job",
      "description": "Job listing posted by an employer or business owner",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["fulltime", "parttime", "contract", "remote"] },
        "salary": { "type": "string", "maxLength": 100 },
        "location": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 100 },
        "desc": { "type": "string", "maxLength": 3000 },
        "posterEmail": { "type": "string", "maxLength": 128 },
        "posterName": { "type": "string", "maxLength": 100 },
        "posterRole": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "type", "location", "contact", "desc", "posterEmail"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Public notice or bulletin item",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["hiring", "looking", "general"] },
        "occupation": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 100 },
        "desc": { "type": "string", "maxLength": 3000 },
        "posterEmail": { "type": "string", "maxLength": 128 },
        "posterName": { "type": "string", "maxLength": 100 },
        "posterRole": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "title", "type", "contact", "desc", "posterEmail"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Feed post shared with community members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "authorEmail": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 500000 },
        "content": { "type": "string", "maxLength": 4000 },
        "image": { "type": "string", "maxLength": 500000 },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "authorEmail", "content", "timestamp"]
    },
    "ProfessionalEvent": {
      "title": "ProfessionalEvent",
      "description": "Networking or learning event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "hostEmail": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "date": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["Webinar", "Meetup", "Workshop"] },
        "image": { "type": "string", "maxLength": 500000 }
      },
      "required": ["id", "hostEmail", "title", "description", "date", "location", "type"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "description": "Application submitted for a job opening",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "jobId": { "type": "string", "maxLength": 64 },
        "jobTitle": { "type": "string", "maxLength": 150 },
        "employerEmail": { "type": "string", "maxLength": 128 },
        "candidateEmail": { "type": "string", "maxLength": 128 },
        "candidateName": { "type": "string", "maxLength": 100 },
        "candidatePhoto": { "type": "string", "maxLength": 500000 },
        "status": { "type": "string", "enum": ["Applied", "Under Review", "Interviewing", "Offered", "Rejected"] },
        "appliedAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "jobId", "employerEmail", "candidateEmail", "status", "appliedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled discovery call or consultation meeting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "hostEmail": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 100 },
        "bookerEmail": { "type": "string", "maxLength": 128 },
        "bookerName": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "timeSlot": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Scheduled", "Completed", "Cancelled"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "hostEmail", "bookerEmail", "topic", "date", "timeSlot", "status", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message sent between two corporate members",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "from": { "type": "string", "maxLength": 128 },
        "to": { "type": "string", "maxLength": 128 },
        "threadKey": { "type": "string", "maxLength": 260 },
        "text": { "type": "string", "maxLength": 4000 },
        "time": { "type": "number" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "from", "to", "threadKey", "text", "time"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app alert sent to a user",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userEmail": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["msg", "job", "assign", "ann", "account"] },
        "text": { "type": "string", "maxLength": 200 },
        "sub": { "type": "string", "maxLength": 500 },
        "time": { "type": "number" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userEmail", "type", "text", "time", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of corporate member profiles"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of job opportunities and vacancies"
    },
    "/announcements/{annId}": {
      "schema": "Announcement",
      "description": "Collection of platform-wide bulletins and notices"
    },
    "/communityPosts/{postId}": {
      "schema": "CommunityPost",
      "description": "Collection of community network posts"
    },
    "/events/{eventId}": {
      "schema": "ProfessionalEvent",
      "description": "Collection of professional networking webinars, workshops, and meetups"
    },
    "/applications/{appId}": {
      "schema": "JobApplication",
      "description": "Collection of candidate job applications"
    },
    "/appointments/{apptId}": {
      "schema": "Appointment",
      "description": "Collection of scheduled discovery calls and consultations"
    },
    "/messages/{msgId}": {
      "schema": "Message",
      "description": "Direct chat communication messages"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
