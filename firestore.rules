rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adrielaturinda4@gmail.com' ||
        request.auth.token.email == 'ankundap6@gmail.com'
      );
    }

    function isOwner(userEmail) {
      return isSignedIn() && request.auth.token.email == userEmail;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == resource.data.email ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email == resource.data.email);
    }

    // Jobs Collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.token.email == resource.data.posterEmail ||
        isAdmin()
      );
    }

    // Announcements Collection
    match /announcements/{annId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.token.email == resource.data.posterEmail ||
        isAdmin()
      );
    }

    // Community Posts Collection
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // e.g. liking post
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.authorEmail ||
        isAdmin()
      );
    }

    // Professional Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // e.g. joining/leaving attendee list
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.hostEmail ||
        isAdmin()
      );
    }

    // Job Applications Collection
    match /applications/{appId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.candidateEmail ||
        request.auth.token.email == resource.data.employerEmail ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.candidateEmail;
      allow update: if isSignedIn() && (
        request.auth.token.email == resource.data.employerEmail ||
        request.auth.token.email == resource.data.candidateEmail ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.candidateEmail ||
        isAdmin()
      );
    }

    // Appointments Collection
    match /appointments/{apptId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.bookerEmail ||
        request.auth.token.email == resource.data.hostEmail ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.bookerEmail;
      allow update: if isSignedIn() && (
        request.auth.token.email == resource.data.hostEmail ||
        request.auth.token.email == resource.data.bookerEmail ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.bookerEmail ||
        isAdmin()
      );
    }

    // Chat Messages Collection
    match /messages/{msgId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.from ||
        request.auth.token.email == resource.data.to ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.from;
      allow update: if isSignedIn() && (
        request.auth.token.email == resource.data.to ||
        request.auth.token.email == resource.data.from
      );
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.from ||
        isAdmin()
      );
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.userEmail ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.token.email == resource.data.userEmail;
      allow delete: if isSignedIn() && (
        request.auth.token.email == resource.data.userEmail ||
        isAdmin()
      );
    }
  }
}
