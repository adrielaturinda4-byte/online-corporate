rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adrielaturinda4@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'adrielaturinda4@gmail.com')
      );
    }

    // Test connection doc for initial boot check
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isMasterAdmin();
    }

    // Job listings
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Professional Events
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Community Posts
    match /community_posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Job Applications
    match /applications/{applicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Direct Messages
    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
